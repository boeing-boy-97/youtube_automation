# ===========================================================================
# ClipForge AI — environment inventory.
# Copy to .env and fill EVERY value. Nothing here has a silent default.
# Any missing value that a feature needs produces
# "Configuration required — processing cannot start." in the UI/API.
# ===========================================================================

# --- Runtime -------------------------------------------------------------
NODE_ENV=production
APP_URL=https://clips.example.com          # public origin of the web app (HTTPS in prod)
API_PORT=4000
WEB_PORT=3000
ALLOWED_ORIGINS=https://clips.example.com        # explicit allow-list; a single '*' wildcard is permitted (e.g. https://*.preview.example.com)
TIMEZONE=Asia/Kolkata                       # explicit; no implicit server TZ
LOG_LEVEL=info

# --- Persistence ---------------------------------------------------------
DATABASE_URL=postgresql://clipforge:CHANGE_ME@postgres:5432/clipforge?schema=public
REDIS_URL=redis://redis:6379
REDIS_PREFIX=clipforge

# --- Cryptography --------------------------------------------------------
# 32-byte base64. Used for AES-256-GCM encryption of OAuth tokens at rest.
# Generate: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=
# 32+ char secret used to HMAC session ids and CSRF tokens.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# --- Bootstrap -----------------------------------------------------------
# One-time administrator bootstrap token (no default admin/password is ever created).
# Generate: openssl rand -hex 32   -> then POST /api/auth/bootstrap with it.
ADMIN_BOOTSTRAP_TOKEN=
# Opt-in self-service signup. false = only administrators create accounts.
ALLOW_SELF_REGISTRATION=false
BOOTSTRAP_ADMIN_EMAIL=

# --- Firebase Authentication (optional) ----------------------------------
# Leave all of these empty to run on email+password only: the dashboard then hides the
# Google button and /api/auth/providers reports firebase.enabled=false.
# Full click-by-click guide: docs/FIREBASE-AUTH.md
# Server-side token verification (Firebase console -> Project settings -> Service accounts
# -> Generate new private key). Use EITHER the three fields OR the one-line JSON blob.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=          # keep the \n escapes exactly as the JSON has them
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...",...}
# Browser config (Firebase console -> Project settings -> Your apps -> Web app -> SDK setup).
# These are public by design; the API serves them to the login page.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=      # defaults to <project>.firebaseapp.com
FIREBASE_WEB_APP_ID=
# Does a valid Google account that ClipForge has never seen get an account? Default: no.
FIREBASE_ALLOW_NEW_USERS=false
FIREBASE_REQUIRE_VERIFIED_EMAIL=true

# --- Object storage ------------------------------------------------------
# STORAGE_DRIVER must be explicit: "s3" (AWS S3 / Cloudflare R2) or "local".
STORAGE_DRIVER=
STORAGE_LOCAL_ROOT=/var/lib/clipforge/objects
STORAGE_LOCAL_PUBLIC_BASE_URL=https://clips.example.com/media
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=https://media.example.com

# --- AI providers --------------------------------------------------------
# No provider/model fallback exists. Both must be set or AI stages fail closed.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash
WORK_DIR=/var/lib/clipforge/work
# Chunk size advertised to the browser. Lower it to 3 when a proxy in front of the API buffers
# request bodies (Vercel functions cap at 4.5 MB). S3/R2 multipart parts must stay >= 5 MiB.
UPLOAD_PART_SIZE_MIB=16
AI_ENGINE_URL=http://ai-engine:8100
AI_ENGINE_API_KEY=

# --- Video processing ----------------------------------------------------
VIDEO_PROCESSOR_URL=http://video-processor:8200
VIDEO_PROCESSOR_API_KEY=
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
AI_ENGINE_WORK_DIR=/var/lib/clipforge/work
# Chunk size advertised to the browser. Lower it to 3 when a proxy in front of the API buffers
# request bodies (Vercel functions cap at 4.5 MB). S3/R2 multipart parts must stay >= 5 MiB.
UPLOAD_PART_SIZE_MIB=16

# --- Platform connectors -------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://clips.example.com/api/accounts/youtube/callback

META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0
META_REDIRECT_URI=https://clips.example.com/api/accounts/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=

# --- Queue / workers -----------------------------------------------------
WORKER_CONCURRENCY_AI=2
WORKER_CONCURRENCY_RENDER=1
WORKER_CONCURRENCY_PUBLISH=2
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=20

# --- Deployment / operations -------------------------------------------------
# Public hostname Caddy obtains a certificate for (production compose only).
CLIPFORGE_DOMAIN=
# Contact address for ACME certificate-expiry notices.
ACME_EMAIL=
# Public HTTPS base URL that Meta fetches Reel files from. Required for Instagram publishing;
# it must resolve to this deployment and stay valid for the configured asset retention window.
STORAGE_PUBLIC_BASE_URL=
# PostgreSQL backup cadence and retention (the backup service runs inside the prod compose stack).
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# --- Test-only switches ------------------------------------------------------
# TEST_MODE=1 unlocks the deterministic fixture AI provider. It must stay 0 in production, and
# AI_PROVIDER must be 'gemini' there. Fixture output is prefixed so it can never be mistaken
# for a model result.
TEST_MODE=0
