{
  "name": "@clipforge/api",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "worker:ai": "tsx src/workers/ai.worker.ts",
    "worker:render": "tsx src/workers/render.worker.ts",
    "worker:publish": "tsx src/workers/publish.worker.ts",
    "worker:scheduler": "tsx src/workers/scheduler.worker.ts",
    "worker:recovery": "tsx src/workers/recovery.worker.ts",
    "test": "vitest run --root ../.. --config tests/vitest.config.ts",
    "test:integration": "vitest run --root ../.. --config tests/vitest.integration.config.ts"
  },
  "dependencies": {
    "@clipforge/database": "1.0.0",
    "@clipforge/shared-types": "1.0.0",
    "@clipforge/validation": "1.0.0",
    "@clipforge/platform-connectors": "1.0.0",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/swagger": "7.4.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "@aws-sdk/client-s3": "3.709.0",
    "@aws-sdk/s3-request-presigner": "3.709.0",
    "argon2": "0.41.1",
    "bullmq": "5.34.10",
    "ioredis": "5.4.2",
    "multer": "2.0.2",
    "nodemailer": "6.9.16",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "zod": "3.24.1",
    "cookie-parser": "1.4.7"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/multer": "2.0.0",
    "@types/cookie-parser": "1.4.8",
    "@types/node": "20.17.10",
    "supertest": "7.1.3",
    "@types/supertest": "6.0.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
