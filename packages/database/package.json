{ "name": "@clipforge/database", "version": "1.0.0", "main": "dist/index.js", "types": "dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate", "migrate": "prisma migrate dev", "migrate:deploy": "prisma migrate deploy",
